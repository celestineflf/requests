<?xml version="1.0" encoding="utf-8"?>
<odoo>



        <!-- Ticket Menu Kanban View -->
    
       <record model="ir.ui.view" id="view_mr_ticket_kanban">
            <field name="name">req.mr.ticket.kanban</field>
            <field name="model">req.mr.ticket</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                    <field name="name"/>
                    <field name="progress"/>
                    <field name="short_desc"/>
                    <field name="state"/>
                    <field name="type"/>
                    <field name="date_sent"/>
                    <field name="is_urgent"/>
                    <templates>
                        <t t-name="kanban-box">
                          <div t-attf-class="o_kanban_record oe_kanban_global_click">
                              <div class="o_kanban_record_top mb16">
                                  <div class="o_kanban_record_headings mt4">
                                      <strong class="o_kanban_record_title"><span><t t-esc="record.name.value"/></span></strong>
                                  </div>
                                  <field name="state" widget="label_selection" options="{'classes': {'new': 'default', 'cancel': 'default', 'done': 'default'}}"/> 
                              </div>
                              <div class="o_kanban_primary_right">
                                  <span><p>
                                      Urgent?
                                  </p><field name="is_urgent" widget="boolean_toggle" readonly="1" options="{'editable':false}"/></span>
                              </div>
                              <div class="o_kanban_record_bottom">
                                  <div class="oe_kanban_bottom_left text-muted">
                                      <span><t t-esc="record.type.value"/> -- Sent on: <t t-esc="record.date_sent.value"/></span>
                                  </div>
                                  <div class="oe_kanban_bottom_left">
                                      <span><field name="short_desc"/></span>
                                  </div>
                                  <div class="oe_kanban_bottom_right">
                                      <field name="progress" widget="percentpie">Progress</field>
                                  </div>
                              </div>
                          </div>   
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>   

        <!-- Ticket Calendar View -->

        <record id="view_mr_ticket_calendar" model="ir.ui.view">
            <field name="name">req.mr.ticket.calendar</field>
            <field name="model">req.mr.ticket</field>
            <field name="arch" type="xml">
               <calendar string="Ticket Appointments" date_start="date_meeting" color="state" hide_time="false"  event_limit="1" quick_add="False">
                   <field name="meet_users"/>
                   <field name="meeting_desc"/>
                   <field name="state" invisible="1"/>
                   <field name="meet_time" widget="float_time"/>
               </calendar>
            </field>   
        </record>

    
        <!-- Ticket Search View -->

        <record id="view_mr_ticket_filter" model="ir.ui.view">
            <field name="name">req.mr.ticket.filter</field>
            <field name="model">req.mr.ticket</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="short_desc"/>
                    <field name="type"/>
                    <filter name="filter_new" string="New Tickets" domain="[('state', '=', 'new')]"/>
                    <filter name="filter_approve" string="Approved Tickets" domain="[('state', '=', 'approve')]"/>
                    <filter name="filter_done" string="Completed Tickets" domain="[('state', '=', 'done')]"/>
                    <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                    <filter name="filter_standard" string="Standard View" domain="['|', '|', ('state', '=', 'approve'), ('state', '=', 'sent'), ('state', '=', 'new')]"/>
                </search>
            </field>
        </record>
        
        <!-- Ticket Form View -->
    
        <record id="view_mr_ticket_form" model="ir.ui.view">
            <field name="name">req.mr.ticket.form</field>
            <field name="model">req.mr.ticket</field>
            <field name="arch" type="xml">
                <form string="Management Tickets">
                    <header>
                       <button name="action_ticket_send" string="Send for Approval" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'new')]}"/>
                        <button name="action_ticket_approve" string="Approve" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                        <button name="action_ticket_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '=', 'cancel')]}"/>
                        <button name="action_ticket_reset" string="Reset to New" type="object" attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                        <button name="action_ticket_done" string="Mark as Done" type="object" attrs="{'invisible': [('state', '!=', 'approve')]}"/>
                       <field name="state" widget="statusbar" statusbar_visible="new,sent,approve,pending"/>
                    </header> 
                    <sheet>
                        <div class="oe_title">
                           <h1>
                               <field name="name" readonly="1"/>
                           </h1> 
                        </div>
                        <group name="ticket_header">
                            <group name="ticket_details_str">
                                <field name="user_id"/>
                                <field name="type"/>
                                <field name="short_desc"/>
                                <field name="progress" widget="progressbar" readonly="0" options="{'editable':true}"/>
                            </group>
                            <group name="ticket_dates">
                                <field name="is_urgent"/>
                                <field name="date_sent" readonly="1"/>
                                <field name="date_approve" readonly="1"/>
                                <field name="date_end" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Ticket Details" name="description">
                                <field name="description"/>
                            </page>
                            <page string="Statistics" name="stats">
                                <group name="time_management" string="Time Management">
                                    <field name="duration" widget="float_time"/>
                                </group>
                            </page>
                            <page string="Appointment" name="meeting">
                                <group>
                                    <group name="meet_details" string="Appointment Details">
                                        <field name="date_meeting" options="{'format': 'dd / MM  HH'}"/>
                                        <field name="meet_time" widget="float_time"/>
                                        <field name="meet_users" widget="many2many_tags"/>
                                    </group>
                                    <group name="add_info" string="Additional Info">
                                        <field name="meeting_desc"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form> 
            </field>
        </record>
            
    
</odoo>